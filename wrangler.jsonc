{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafaqtec",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  // The site's static files; requests that match no file (e.g. /api/reviews) reach the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "routes": [
    { "pattern": "rafaqtech.com", "custom_domain": true },
    { "pattern": "www.rafaqtech.com/*", "zone_name": "rafaqtech.com" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rafaqtec-reviews",
      "database_id": "a231b1ed-69bd-49c6-8fb7-2ff244362d19",
      "migrations_dir": "migrations"
    }
  ]
}
